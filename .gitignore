# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# 数据库文件（如无需版本控制）
*.sqlite3
*.db

# VSCode 设置（如不共享配置）
.vscode/

# 虚拟环境（若有）
venv/
env/

# 环境变量文件
