*.env

# macOS 系统文件
.DS_Store

# Node.js 相关（如果你用了 Tailwind）
node_modules/
package-lock.json
yarn.lock

# 打包或构建文件夹（如果有）
dist/
build/

# 上传文件（如果不是测试用例）
uploads/
